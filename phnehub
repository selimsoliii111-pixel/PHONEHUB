<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhoneHub — Newest Phones</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background: #07090b;
  color: #f4f5f7;
  min-height: 100vh;
  overflow-x: hidden;
}

/* Background grid */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
  background-size: 64px 64px;
}

/* Green glow */
body::after {
  content: "";
  position: fixed;
  width: 700px;
  height: 700px;
  right: -220px;
  top: -170px;
  z-index: -1;
  background: radial-gradient(circle, rgba(137,255,25,.18), transparent 65%);
  filter: blur(20px);
}

a {
  text-decoration: none;
  color: inherit;
}

/* NAVIGATION */
nav {
  height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4%;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(7,9,11,.75);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255,255,255,.06);
}

.logo {
  font-size: 20px;
  font-weight: 800;
  padding: 11px 18px;
  border: 1px solid #30343a;
  border-radius: 30px;
  background: #111419;
  display: flex;
  gap: 10px;
  align-items: center;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #9cff24;
  box-shadow: 0 0 14px #9cff24;
}

.links {
  display: flex;
  gap: 30px;
  color: #aeb4be;
  font-size: 14px;
}

.links a:hover {
  color: #9cff24;
}

/* BUTTONS */
.btn {
  border: 0;
  border-radius: 28px;
  padding: 14px 25px;
  background: #9cff24;
  color: #081000;
  font-weight: 800;
  cursor: pointer;
  transition: .2s;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(156,255,36,.25);
}

.btn.secondary {
  background: transparent;
  color: white;
  border: 1px solid #343941;
}

/* HERO */
.hero {
  min-height: calc(100vh - 82px);
  padding: 90px 4% 70px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #30353c;
  background: #111419;
  border-radius: 25px;
  padding: 9px 16px;
  color: #aeb4be;
  font-size: 13px;
  margin-bottom: 28px;
}

.badge span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #9cff24;
}

h1 {
  font-size: clamp(55px, 7vw, 105px);
  line-height: .88;
  letter-spacing: -5px;
  max-width: 650px;
}

.green {
  color: #9cff24;
}

.subtitle {
  font-size: 18px;
  line-height: 1.7;
  color: #9da6b5;
  max-width: 600px;
  margin: 34px 0;
}

.actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.stats {
  display: flex;
  gap: 55px;
  margin-top: 60px;
}

.stat strong {
  display: block;
  font-size: 27px;
}

.stat small {
  color: #8c95a4;
  font-size: 12px;
  letter-spacing: 1px;
}

/* PHONE SHOWCASE */
.visual {
  position: relative;
}

.phone-card {
  height: 510px;
  border-radius: 32px;
  overflow: hidden;
  border: 1px solid #333840;
  background: linear-gradient(145deg,#dfe5f0,#8994a8 45%,#1b2027);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 30px 80px rgba(0,0,0,.5);
  transform: rotate(2deg);
}

.phone {
  width: 190px;
  height: 390px;
  border-radius: 30px;
  background: linear-gradient(145deg,#11151b,#3d4655);
  border: 7px solid #0d1014;
  box-shadow: 20px 20px 50px rgba(0,0,0,.5);
  position: relative;
  transform: rotate(-9deg);
}

.phone::before {
  content: "";
  position: absolute;
  top: 18px;
  left: 18px;
  width: 60px;
  height: 80px;
  border-radius: 16px;
  background: #151a20;
  box-shadow: inset 0 0 0 2px #303741;
}

.camera {
  position: absolute;
  width: 15px;
  height: 15px;
  background: #050607;
  border-radius: 50%;
  top: 29px;
  left: 30px;
  box-shadow: 24px 0 #050607, 0 24px #050607;
}

.feature {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 210px;
  padding: 13px 20px;
  border-radius: 18px;
  background: rgba(30,33,37,.82);
  backdrop-filter: blur(12px);
  text-align: center;
  color: white;
}

.feature small {
  display: block;
  color: #9da6b5;
  font-size: 11px;
  margin-bottom: 4px;
}

/* PHONE SECTION */
section {
  padding: 90px 4%;
}

.section-title {
  font-size: 48px;
  letter-spacing: -2px;
  margin-bottom: 35px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.card {
  background: #101318;
  border: 1px solid #292e35;
  border-radius: 24px;
  padding: 18px;
  transition: .25s;
}

.card:hover {
  transform: translateY(-7px);
  border-color: #9cff24;
}

.card-img {
  height: 240px;
  border-radius: 18px;
  background: linear-gradient(145deg,#202630,#080a0d);
  display: flex;
  align-items: center;
  justify-content: center;
